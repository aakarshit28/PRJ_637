# ORGINTEL server settings. Copy this file to ".env" and fill in what you need.
# Everything here is optional: the server runs without any of it.

# --- Server ---
PORT=3000
# HOST=0.0.0.0
# Set to 1 when the app is served over https (required in production so the login cookie is https-only)
# COOKIE_SECURE=1

# --- Email delivery of executive briefings (needs "npm install" once) ---
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<an app password, not your normal password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_SECURE=true        # use with port 465

# --- AI-written briefing summary (optional). Without a key the summary is rule-based. ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
